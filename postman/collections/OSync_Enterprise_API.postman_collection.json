            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"EM_ANDAMENTO\",\n  \"valorServico\": 180.00,\n  \"valorPecas\": 120.00,\n  \"valorTotal\": 300.00,\n  \"laudoTecnico\": \"Troca de capacitores e teste de estabilidade realizado.\"\n}"
