              "mode": "raw",
              "raw": "{\n  \"clienteId\": \"clxxxxxxxxxx\",\n  \"equipamentoId\": null,\n  \"prioridade\": \"ALTA\",\n  \"descricaoProblema\": \"Aparelho não liga após descarga elétrica na fonte\",\n  \"dataPrazo\": \"2026-11-20T18:00:00.000Z\"\n}"
