  "item": [
    {
      "name": "1. Ordens de Serviço (OS)",
      "item": [
        {
          "name": "Listar todas as OS",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/ordens",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ordens"]
            }
          }
        },
        {
          "name": "Filtrar OS por Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/ordens?status=ABERTA",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ordens"],
              "query": [
                {
                  "key": "status",
                  "value": "ABERTA",
                  "description": "ABERTA | EM_ANDAMENTO | AGUARDANDO_PECA | CONCLUIDA | ENTREGUE | CANCELADA"
                }
              ]
            }
          }
        },
        {
          "name": "Buscar OS por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/ordens/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ordens", ":id"],
              "variable": [{ "key": "id", "value": "" }]
